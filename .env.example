# Copy this file to .env and fill in your provider details.
# Do not put your API key in public/ or commit .env to Git.

AI_API_KEY=replace_with_your_new_api_key
AI_BASE_URL=https://api.example.com/v1
AI_MODEL=your-model-name

# Optional: change the upstream chat-completions path if your provider uses another route.
AI_CHAT_PATH=/chat/completions

PORT=3000